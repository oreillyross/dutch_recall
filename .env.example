LLM_PROVIDER=anthropic        # anthropic | openai (default: anthropic)
LLM_MODEL=                    # optional override of the default model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ACCESS_CODE=                  # optional but recommended on a public URL
RATE_LIMIT_PER_MIN=           # optional, per-IP requests per minute (default 30)
NEXT_PUBLIC_LANG=nl          # nl | de | fr | it (build time; default nl)
